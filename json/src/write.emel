import Std.Map
import Dynamic.{Dynamic, Null, Bool, Number, Text, Items, Fields}
import Dynamic.Number

# Writes `value` without whitespace. Keys come in the order of the Map. A string escapes `"`,
# `\` and the control characters, and keeps every other character as it is.
pub fn write(value: Dynamic) -> String {
  value match {
    Null      -> "null"
    Bool(b)   -> if b { "true" } else { "false" }
    Number(n) -> Number.to_string(n)
    Text(s)   -> quote(s)
    Items(xs) -> "[#{String.join(List.map(xs, write), ",")}]"
    Fields(m) -> {
      members = List.map(Map.to_list(m), fn((key, x)) { "#{quote(key)}:#{write(x)}" })
      "{#{String.join(members, ",")}}"
    }
  }
}

fn quote(s: String) -> String {
  "\"#{String.concat(List.map(String.chars(s), escaped))}\""
}

fn escaped(c: String) -> String {
  c match {
    "\""    -> "\\\""
    "\\"    -> "\\\\"
    "\n"    -> "\\n"
    "\r"    -> "\\r"
    "\t"    -> "\\t"
    "\u{8}" -> "\\b"
    "\u{c}" -> "\\f"
    _ -> {
      p = List.fold(String.code_points(c), 0, fn(_, p) { p })
      if p < 32 { "\\u00#{hex(p / 16)}#{hex(p % 16)}" } else { c }
    }
  }
}

fn hex(d: Int) -> String {
  List.get(String.chars("0123456789abcdef"), d) |> Option.or("0")
}
