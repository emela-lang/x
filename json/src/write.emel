import Dynamic.{Dynamic, Null, Bool, Number, Text, Items, Fields, Binary}
import Base64

# Writes `value` without whitespace. Keys come in the order of the Map. A string escapes `"`,
# `\` and the control characters, and keeps every other character as it is. JSON has no bytes, so
# Binary is written as a string of standard base64 with padding (RFC 4648 section 4).
pub fn write(value: Dynamic) -> String {
  value match {
    Null      -> "null"
    Bool(b)   -> if b { "true" } else { "false" }
    Number(n) -> n.to_string()
    Text(s)   -> quote(s)
    Items(xs) -> "[#{xs.map(write).join(",")}]"
    Binary(b) -> quote(Base64.encode(b))
    Fields(m) -> {
      members = m.to_list().map(fn((key, x)) { "#{quote(key)}:#{write(x)}" })
      "{#{members.join(",")}}"
    }
  }
}

fn quote(s: String) -> String {
  "\"#{s.chars().map(escaped).join("")}\""
}

fn escaped(c: String) -> String {
  c match {
    "\""    -> "\\\""
    "\\"    -> "\\\\"
    "\n"    -> "\\n"
    "\r"    -> "\\r"
    "\t"    -> "\\t"
    "\u{8}" -> "\\b"
    "\u{c}" -> "\\f"
    _ -> {
      p = c.code_points().fold(0, fn(_, p) { p })
      if p < 32 { "\\u00#{hex(p / 16)}#{hex(p % 16)}" } else { c }
    }
  }
}

fn hex(d: Int) -> String {
  "0123456789abcdef".chars().get(d).or("0")
}
