import Dynamic.{Dynamic, Decode, Encode, DecodeError, Text, Items}
import Lib.{SyntaxError}

type User(name: String, tags: List[String])
  derive Eq

impl User: Encode {
  fn to_dynamic(self) {
    Dynamic.object(
      [("name", Text(self.name)), ("tags", Items(List.map(self.tags, fn(t) { Text(t) })))],
    )
  }
}

impl User: Decode {
  fn from_dynamic(d) {
    User(
      name: Dynamic.field(d, "name", Dynamic.string),
      tags: Dynamic.field(d, "tags", Dynamic.list(Dynamic.string)),
    )
  }
}

@test
fn encodes() {
  assert Lib.encode(User(name: "a", tags: ["x"])) == "{\"name\":\"a\",\"tags\":[\"x\"]}"
}

@test
fn decodes() {
  user: User = Lib.decode("{\"name\":\"a\",\"tags\":[\"x\"]}")
  assert user == User(name: "a", tags: ["x"])
}

fn kind(text: String) -> String {
  {
    user: User = Lib.decode(text)
    "ok"
  } escape {
    SyntaxError(..) -> "syntax"
    DecodeError(..) -> "decode"
  }
}

@test
fn fails_with_either_error() {
  assert kind("{") == "syntax"
  assert kind("{\"name\":1}") == "decode"
}
