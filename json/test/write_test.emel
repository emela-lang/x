import Std.Map
import Dynamic.{Dynamic, Null, Bool, Text, Items, Fields}
import Dynamic.Number
import Lib

fn number(n: Int) -> Dynamic {
  Dynamic.Number(Number.from_int(n))
}

@test
fn writes_literals() {
  assert Lib.to_string(Null) == "null"
  assert Lib.to_string(Bool(True)) == "true"
  assert Lib.to_string(Bool(False)) == "false"
  assert Lib.to_string(number(-1500)) == "-1500"
  assert Lib.to_string(Lib.parse("0.25")) == "0.25"
}

@test
fn writes_arrays_and_objects() {
  assert Lib.to_string(Items([])) == "[]"
  assert Lib.to_string(Fields(Map.empty())) == "{}"
  assert Lib.to_string(Items([number(1), Null, Items([])])) == "[1,null,[]]"
  assert Lib.to_string(Fields(Map.from_list([("b", number(2)), ("a", Text("x"))])))
    == "{\"a\":\"x\",\"b\":2}"
}

@test
fn escapes_strings() {
  assert Lib.to_string(Text("aあ😀/")) == "\"aあ😀/\""
  assert Lib.to_string(Text("\"\\\n\r\t\u{8}\u{c}")) == "\"\\\"\\\\\\n\\r\\t\\b\\f\""
  assert Lib.to_string(Text("\u{0}\u{1f}")) == "\"\\u0000\\u001f\""
  assert Lib.to_string(Fields(Map.from_list([("k\"", Null)]))) == "{\"k\\\"\":null}"
}

@test
fn round_trips() {
  s = "{\"a\":[1,-0.5,1e-7,\"x\\ny\",true,null,{}],\"b\":{\"c\":\"\\u0001あ\"}}"
  assert Lib.to_string(Lib.parse(s)) == s
  assert Lib.parse(Lib.to_string(Lib.parse(s))) == Lib.parse(s)
}
