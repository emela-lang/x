# Dates, times and offsets on top of Std.Instant and Std.Duration: the calendar, RFC 3339 and
# ISO 8601 text, and arithmetic on them. A point in time is Std's Instant and a length of time is
# Std's Duration; this Pome does not make its own, so an Instant from Clock or from x/uuid goes
# into every function here as it is.
#
# ```emela
# import Std.Clock.{Clock}
# import Time
# import Time.Offset
#
# fn stamp() -> String use { Clock } {
#   jst = Offset.from_hours(9).or(Offset.utc())
#   Time.now(jst).to_string() # 2026-10-29T09:00:00.000+09:00
# }
# ```
#
# The current time comes from Std's Clock, so a test fixes it with TestClock; this Pome adds no
# effect. Everything is to the millisecond, as Instant is, and leap seconds are not counted.

import Std.Clock.{Clock}
import Std.Duration.{Duration}
import Std.Instant.{Instant}
import Date.{Date}
import Offset.{Offset}
import OffsetDateTime.{OffsetDateTime}

## The current time from Clock, in `offset`.
pub fn now(offset: Offset) -> OffsetDateTime use { Clock } {
  OffsetDateTime.from_instant((use Clock).now(), offset)
}

## The current date from Clock, in `offset`. In `+09:00` the date changes at 15:00 UTC.
pub fn today(offset: Offset) -> Date use { Clock } {
  now(offset).date()
}

## Reads RFC 3339 as `OffsetDateTime.parse` does, as the point in time it is. It reads what
## `Instant.to_string` writes. Fails with `ParseError` if `OffsetDateTime.parse` does.
pub fn parse_instant(s: String) -> Instant fails ParseError {
  OffsetDateTime.parse(s).to_instant()
}

## `n` days of 24 hours, as `Duration.hours(n * 24)`.
pub fn days(n: Int64) -> Duration {
  Duration.hours(n * 24)
}

## ISO 8601 (`PT1H30M`, `PT0.5S`, `-PT36H`), in hours, minutes and seconds only, as a Duration is
## exact: a day is not always 24 hours somewhere, and a month is not a fixed length. Zero is
## `PT0S`. The seconds have as many digits of fraction as they need, up to three.
pub fn duration_to_string(d: Duration) -> String {
  ms = d.to_milliseconds()
  sign = if ms < 0 { "-" } else { "" }
  a = ms.abs()
  h = a / 3600000
  m = a / 60000 % 60
  s = a / 1000 % 60
  f = (a % 1000).to_int()
  hours = if h > 0 { "#{h.to_string()}H" } else { "" }
  minutes = if m > 0 { "#{m.to_string()}M" } else { "" }
  seconds = if s > 0 || f > 0 { "#{s.to_string()}#{fraction(f)}S" } else { "" }
  body = "#{hours}#{minutes}#{seconds}"
  if body == "" { "PT0S" } else { "#{sign}PT#{body}" }
}

## Reads an ISO 8601 duration of days, hours, minutes and seconds: `P2D`, `PT1H30M`, `P1DT12H`,
## `PT0.5S`, with an optional `-` or `+` before the `P`. A day is 24 hours. Only the seconds may
## have a fraction, after `.` or `,`, and digits after the third are dropped. Fails with
## `ParseError` if anything else is in `s`, including years, months and weeks (`P1Y`, `P1M`,
## `P1W`), whose length depends on the calendar.
pub fn parse_duration(s: String) -> Duration fails ParseError {
  (negative, rest) = if s.starts_with("-") {
    (True, after(s, "-"))
  } else if s.starts_with("+") {
    (False, after(s, "+"))
  } else {
    (False, Some(s))
  }
  body = rest.and_then(fn(r) { if r.starts_with("P") { after(r, "P") } else { None } })
  ms = body.and_then(designators).map(fn(n) { if negative { 0 - n } else { n } })
  ms.map(Duration.milliseconds).or_fail(ParseError(input: s))
}

# What is after the `P`: `nD`, then `T` and at least one of `nH`, `nM`, `nS` in that order.
fn designators(s: String) -> Option[Int64] {
  s.split("T") match {
    [day] -> if day == "" { None } else { days_part(day) }
    [day, time] -> (days_part(day), time_part(time)) match {
      (Some(d), Some(t)) -> Some(d + t)
      _                  -> None
    }
    _     -> None
  }
}

fn days_part(s: String) -> Option[Int64] {
  if s == "" {
    Some(0)
  } else {
    s.split("D") match {
      [n, ""] -> number(n).map(fn(n) { n * 86400000 })
      _       -> None
    }
  }
}

fn time_part(s: String) -> Option[Int64] {
  if s == "" {
    None
  } else {
    (h, after_h) = unit(s, "H", 3600000)
    (m, after_m) = unit(after_h, "M", 60000)
    sec = if after_m == "" {
      Some(0)
    } else {
      after_m.split("S") match {
        [n, ""] -> seconds(n)
        _       -> None
      }
    }
    (h, m, sec) match {
      (Some(h), Some(m), Some(sec)) -> Some(h + m + sec)
      _                             -> None
    }
  }
}

# The milliseconds of `nX` at the start of `s` and what follows it, or 0 and all of `s` if `s` has
# no `X`.
fn unit(s: String, designator: String, ms: Int) -> (Option[Int64], String) {
  s.split(designator) match {
    [_]       -> (Some(0), s)
    [n, rest] -> (number(n).map(fn(n) { n * Int64.from_int(ms) }), rest)
    _         -> (None, "")
  }
}

# `n`, `n.f...` or `n,f...` seconds, as milliseconds.
fn seconds(s: String) -> Option[Int64] {
  parts = if s.contains(".") { s.split(".") } else { s.split(",") }
  parts match {
    [n] -> number(n).map(fn(n) { n * 1000 })
    [n, f] -> (number(n), milliseconds(f)) match {
      (Some(n), Some(f)) -> Some(n * 1000 + Int64.from_int(f))
      _                  -> None
    }
    _   -> None
  }
}

# One to ten ASCII digits, so that the milliseconds of days, hours, minutes and seconds of that many
# digits add up within an Int64.
fn number(s: String) -> Option[Int64] {
  cps = s.code_points()
  n = cps.length()
  if n == 0 || n > 10 || !cps.all(fn(c) { c >= 48 && c <= 57 }) {
    None
  } else {
    Some(cps.fold(from: 0, f: fn(acc, c) { acc * 10 + Int64.from_int(c - 48) }))
  }
}

# One or more digits of a fraction of a second, as milliseconds. Digits after the third are dropped.
fn milliseconds(fraction: String) -> Option[Int] {
  cps = fraction.code_points()
  if cps.is_empty() || !cps.all(fn(c) { c >= 48 && c <= 57 }) {
    None
  } else {
    first = cps.take(3).append([48, 48, 48]).take(3)
    Some(first.fold(from: 0, f: fn(n, c) { n * 10 + c - 48 }))
  }
}

# `.5`, `.05`, `.005`, or nothing for 0.
fn fraction(ms: Int) -> String {
  if ms == 0 {
    ""
  } else if ms % 100 == 0 {
    ".#{(ms / 100).to_string()}"
  } else if ms % 10 == 0 {
    ".#{pad(ms / 10, 2)}"
  } else {
    ".#{pad(ms, 3)}"
  }
}

fn after(s: String, prefix: String) -> Option[String] {
  s.split(prefix) match {
    ["", rest] -> Some(rest)
    _          -> None
  }
}

## Zero-pads `n` to `width` digits. `n` must be non-negative.
fn pad(n: Int, width: Int) -> String {
  pad_onto(n.to_string(), width)
}

# Digits are ASCII, so bytes count them without the grapheme tables (which target c lacks).
fn pad_onto(s: String, width: Int) -> String {
  if s.byte_size() >= width { s } else { pad_onto("0#{s}", width) }
}
