import Std.Duration.{Duration}
import TimeOfDay.{TimeOfDay}

fn time(hour: Int, minute: Int, second: Int) -> TimeOfDay {
  TimeOfDay.from_hms(hour, minute, second).or(TimeOfDay.midnight())
}

fn parsed(s: String) -> Option[TimeOfDay] {
  Some(TimeOfDay.parse(s)) escape {
    ParseError(_) -> None
  }
}

@test
fn from_hms_checks_the_range() {
  assert TimeOfDay.from_hms(23, 59, 59) != None
  assert TimeOfDay.from_hms(24, 0, 0) == None
  assert TimeOfDay.from_hms(0, 60, 0) == None
  assert TimeOfDay.from_hms(0, 0, 60) == None
  assert TimeOfDay.from_hms(-1, 0, 0) == None
  assert TimeOfDay.from_milliseconds_of_day(86399999) != None
  assert TimeOfDay.from_milliseconds_of_day(86400000) == None
}

@test
fn the_parts_come_back() {
  t = TimeOfDay.from_milliseconds_of_day(45296789).or(TimeOfDay.midnight())
  assert (t.hour(), t.minute(), t.second(), t.millisecond()) == (12, 34, 56, 789)
}

@test
fn add_goes_round_the_clock() {
  assert time(23, 0, 0).add(Duration.hours(2)) == time(1, 0, 0)
  assert time(1, 0, 0).add(Duration.hours(-2)) == time(23, 0, 0)
  assert time(9, 0, 0).add(Duration.hours(48)) == time(9, 0, 0)
}

@test
fn to_string_always_writes_the_milliseconds() {
  assert time(9, 5, 0).to_string() == "09:05:00.000"
  assert TimeOfDay.midnight().to_string() == "00:00:00.000"
  assert inspect(time(23, 59, 59)) == "23:59:59.000"
}

@test
fn parse_reads_minutes_seconds_and_fractions() {
  assert parsed("09:05") == Some(time(9, 5, 0))
  assert parsed("09:05:30") == Some(time(9, 5, 30))
  assert parsed("12:34:56.789") == TimeOfDay.from_milliseconds_of_day(45296789)
  assert parsed("12:34:56,7") == TimeOfDay.from_milliseconds_of_day(45296700)
  assert parsed("12:34:56.789999") == TimeOfDay.from_milliseconds_of_day(45296789)
  assert parsed(time(23, 59, 59).to_string()) == Some(time(23, 59, 59))
}

@test
fn parse_refuses_out_of_range_and_other_forms() {
  assert parsed("24:00") == None
  assert parsed("23:59:60") == None
  assert parsed("9:05") == None
  assert parsed("09:05:") == None
  assert parsed("09:05:30.") == None
  assert parsed("0905") == None
  assert parsed("09:05:30Z") == None
  assert parsed("") == None
}
