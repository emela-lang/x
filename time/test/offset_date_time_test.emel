import Std.Duration.{Duration}
import Std.Instant.{Instant}
import Date.{Date}
import TimeOfDay.{TimeOfDay}
import DateTime.{DateTime}
import Offset.{Offset}
import OffsetDateTime.{OffsetDateTime}

fn jst() -> Offset {
  Offset.from_hours(9).or(Offset.utc())
}

fn ms(n: Int64) -> Instant {
  Instant.from_unix_milliseconds(n)
}

fn parsed(s: String) -> Option[OffsetDateTime] {
  Some(OffsetDateTime.parse(s)) escape {
    ParseError(_) -> None
  }
}

fn written(s: String) -> String {
  parsed(s).map(OffsetDateTime.to_string).or("-")
}

@test
fn from_instant_shows_the_local_time() {
  odt = OffsetDateTime.from_instant(ms(0), jst())
  assert odt.to_string() == "1970-01-01T09:00:00.000+09:00"
  assert odt.date() == Date.from_unix_days(0)
  assert Some(odt.time()) == TimeOfDay.from_hms(9, 0, 0)
  assert OffsetDateTime.from_instant(ms(0), Offset.utc()).to_string() == "1970-01-01T00:00:00.000Z"
}

@test
fn instants_go_there_and_back() {
  offsets = [0, 540, -330, 1439, -1439].filter_map(Offset.from_minutes)
  instants = [ms(0), ms(-1), ms(1761696000123), Instant.from_unix_milliseconds(-62167219200 * 1000)]
  back = instants.flat_map(fn(t) {
    offsets.map(fn(o) { OffsetDateTime.from_instant(t, o).to_instant() == t })
  })
  assert back.all(fn(b) { b })
}

@test
fn in_utc_to_string_is_what_instant_writes() {
  instants = [ms(0), ms(-1), ms(1761696000123), Instant.from_unix_milliseconds(253402300800 * 1000)]
  assert instants.all(fn(t) {
    OffsetDateTime.from_instant(t, Offset.utc()).to_string() == t.to_string()
  })
}

@test
fn unix_milliseconds_round_trip_for_uuid_v7() {
  # What x/uuid gives for a version 7 UUID is an Instant of its 48-bit Unix milliseconds.
  made = Instant.from_unix_milliseconds(1761696000123)
  text = OffsetDateTime.from_instant(made, Offset.utc()).to_string()
  assert text == "2025-10-29T00:00:00.123Z"
  assert parsed(text).map(fn(odt) { odt.to_instant().to_unix_milliseconds() })
    == Some(1761696000123)
}

@test
fn with_offset_keeps_the_point_in_time() {
  odt = OffsetDateTime.from_instant(ms(0), jst())
  utc = odt.with_offset(Offset.utc())
  assert utc.to_string() == "1970-01-01T00:00:00.000Z"
  assert utc.to_instant() == odt.to_instant()
  assert utc != odt
}

@test
fn ord_is_by_point_in_time_then_local_time() {
  # a and b are the same point in time; b has the earlier local time. c is an hour later.
  all = [
    "2026-10-29T09:00:00+09:00",
    "2026-10-29T00:00:00Z",
    "2026-10-29T08:59:59+08:00",
  ].filter_map(parsed)
  (a, b, c) = all match {
    [a, b, c] -> (a, b, c)
    _         -> panic("parse")
  }
  assert (b.compare(a), a.compare(c), a.compare(a)) == (Less, Less, Equal)
  assert [c, a, b].sort() == [b, a, c]
}

@test
fn arithmetic_keeps_the_offset() {
  start = parsed("2026-10-29T23:30:00+09:00").or(OffsetDateTime.from_instant(ms(0), jst()))
  assert start.add(Duration.hours(1)).to_string() == "2026-10-30T00:30:00.000+09:00"
  assert start.subtract(Duration.minutes(30)).to_string() == "2026-10-29T23:00:00.000+09:00"
  assert start.add_days(3).to_string() == "2026-11-01T23:30:00.000+09:00"
  assert start.add_months(4).to_string() == "2027-02-28T23:30:00.000+09:00"
  later = parsed("2026-10-29T15:00:00Z").or(start)
  assert later.since(start) == Duration.minutes(30)
}

@test
fn parse_reads_rfc_3339() {
  assert written("2026-10-29T09:00:00+09:00") == "2026-10-29T09:00:00.000+09:00"
  assert written("2026-10-29T00:00:00Z") == "2026-10-29T00:00:00.000Z"
  assert written("2026-10-29t00:00:00z") == "2026-10-29T00:00:00.000Z"
  assert written("2026-10-29 00:00:00.5-05:30") == "2026-10-29T00:00:00.500-05:30"
  assert written("2026-10-29T00:00:00.123456789+00:00") == "2026-10-29T00:00:00.123Z"
  assert written("2026-10-29T00:00:00-00:00") == "2026-10-29T00:00:00.000Z"
  assert written("+010000-01-01T00:00:00.000Z") == "+010000-01-01T00:00:00.000Z"
  assert written("-000001-12-31T23:00+01:00") == "-000001-12-31T23:00:00.000+01:00"
}

@test
fn parse_refuses_a_missing_offset_and_other_forms() {
  assert parsed("2026-10-29T09:00:00") == None
  assert parsed("2026-10-29") == None
  assert parsed("2026-10-29T09:00:00+0900") == None
  assert parsed("2026-10-29T09:00:00 +09:00") == None
  assert parsed("2026-10-29T24:00:00Z") == None
  assert parsed("2026-10-29T23:59:60Z") == None
  assert parsed("2026-02-29T00:00:00Z") == None
  assert parsed("Z") == None
  assert parsed("") == None
}

@test
fn the_local_time_is_kept_as_read() {
  odt = parsed("2026-10-29T09:00:00+09:00").or(OffsetDateTime.from_instant(ms(0), jst()))
  date = Date.from_calendar(2026, 10, 29).or(Date.from_unix_days(0))
  time = TimeOfDay.from_hms(9, 0, 0).or(TimeOfDay.midnight())
  assert odt == OffsetDateTime(local: DateTime(date:, time:), offset: jst())
}
