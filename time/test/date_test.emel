import Date.{Date, Monday, Thursday, Saturday, Sunday}

fn date(year: Int, month: Int, day: Int) -> Date {
  Date.from_calendar(year, month, day).or(Date.from_unix_days(0))
}

fn parsed(s: String) -> Option[Date] {
  Some(Date.parse(s)) escape {
    ParseError(_) -> None
  }
}

@test
fn from_calendar_checks_the_calendar() {
  assert Date.from_calendar(2024, 2, 29) != None
  assert Date.from_calendar(2026, 2, 29) == None
  assert Date.from_calendar(2026, 2, 30) == None
  assert Date.from_calendar(1900, 2, 29) == None
  assert Date.from_calendar(2000, 2, 29) != None
  assert Date.from_calendar(2026, 4, 31) == None
  assert Date.from_calendar(2026, 13, 1) == None
  assert Date.from_calendar(2026, 0, 1) == None
  assert Date.from_calendar(2026, 1, 0) == None
}

@test
fn the_parts_come_back() {
  d = date(2026, 10, 29)
  assert (d.year(), d.month(), d.day()) == (2026, 10, 29)
  b = date(-1, 12, 31)
  assert (b.year(), b.month(), b.day()) == (-1, 12, 31)
}

@test
fn unix_days_count_from_1970() {
  assert date(1970, 1, 1).to_unix_days() == 0
  assert date(1969, 12, 31).to_unix_days() == -1
  assert date(2000, 3, 1).to_unix_days() == 11017
  assert Date.from_unix_days(20390) == date(2025, 10, 29)
}

@test
fn weekday_starts_on_monday() {
  assert date(1970, 1, 1).weekday() == Thursday
  assert date(2026, 10, 29).weekday() == Thursday
  assert date(2026, 11, 1).weekday() == Sunday
  assert date(1969, 12, 29).weekday() == Monday
  assert date(1600, 1, 1).weekday() == Saturday
  assert Ord.compare(Monday, Sunday) == Less
}

@test
fn days_in_month_and_leap_years() {
  assert date(2024, 2, 1).days_in_month() == 29
  assert date(2026, 2, 1).days_in_month() == 28
  assert date(2026, 4, 1).days_in_month() == 30
  assert date(2026, 12, 1).days_in_month() == 31
  assert (Date.is_leap_year(2024), Date.is_leap_year(1900), Date.is_leap_year(2000))
    == (True, False, True)
}

@test
fn add_days_crosses_months_and_years() {
  assert date(2026, 12, 31).add_days(1) == date(2027, 1, 1)
  assert date(2024, 3, 1).add_days(-1) == date(2024, 2, 29)
  assert date(2027, 1, 1).days_since(date(2026, 1, 1)) == 365
  assert date(2026, 1, 1).days_since(date(2027, 1, 1)) == -365
}

@test
fn add_months_keeps_the_day_or_takes_the_last() {
  assert date(2026, 1, 31).add_months(1) == date(2026, 2, 28)
  assert date(2024, 1, 31).add_months(1) == date(2024, 2, 29)
  assert date(2026, 10, 29).add_months(3) == date(2027, 1, 29)
  assert date(2026, 1, 15).add_months(-1) == date(2025, 12, 15)
  assert date(2026, 3, 31).add_months(-13) == date(2025, 2, 28)
  assert date(2024, 2, 29).add_years(1) == date(2025, 2, 28)
}

@test
fn dates_compare_by_day() {
  assert date(2026, 10, 29) < date(2026, 10, 30)
  assert date(-1, 1, 1) < date(0, 1, 1)
  assert [date(2026, 1, 2), date(2025, 12, 31), date(2026, 1, 1)].sort()
    == [date(2025, 12, 31), date(2026, 1, 1), date(2026, 1, 2)]
}

@test
fn to_string_writes_iso_8601() {
  assert date(2026, 10, 29).to_string() == "2026-10-29"
  assert date(5, 1, 2).to_string() == "0005-01-02"
  assert date(10000, 1, 1).to_string() == "+010000-01-01"
  assert date(-1, 12, 31).to_string() == "-000001-12-31"
  assert inspect(date(2026, 10, 29)) == "2026-10-29"
}

@test
fn parse_reads_what_to_string_writes() {
  for_each = [
    date(2026, 10, 29),
    date(0, 1, 1),
    date(10000, 1, 1),
    date(-1, 12, 31),
    date(-271821, 4, 20),
  ]
  assert for_each.map(fn(d) { parsed(d.to_string()) }) == for_each.map(Some)
}

@test
fn parse_refuses_other_forms_and_days_that_do_not_exist() {
  assert parsed("2026-02-30") == None
  assert parsed("2026-2-3") == None
  assert parsed("20261029") == None
  assert parsed("2026-10-29T00:00") == None
  assert parsed("+2026-10-29") == None
  assert parsed("12026-10-29") == None
  assert parsed(" 2026-10-29") == None
  assert parsed("2026-10-+9") == None
  assert parsed("") == None
}
