# A sample Worker: counts visits in KV and greets.
#
#   GET /            -> hello, with the visit count
#   GET /hello/<who> -> hello, <who>
#   GET /boom        -> a defect, answered with 500 by `Http.serve`

import Platform.{CloudflarePlatform}
import Kv.{Kv}
import Std.Console.{Console}
import Std.Env.{Env}
import Std.Http
import Std.Http.Request.{Request, Get}
import Std.Http.Response.{Response}

@entry(Http.serve)
pub fn app(request: Request) -> Response {
  with CloudflarePlatform { route(request) }
}

fn route(request: Request) -> Response use { Console, Env, Kv } {
  (use Console).print_line("#{request.method} #{request.url}")
  (request.method, Request.segments(request)) match {
    (Get, []) -> {
      kv = use Kv
      count = kv.get("visits") |> Option.and_then(parse_count) |> Option.or(0)
      kv.put("visits", Int.to_string(count + 1))
      greeting = (use Env).get("GREETING") |> Option.or("hello")
      Response.new(200, "#{greeting} from Emela (visit ##{count + 1})\n")
    }
    (Get, ["hello", who]) -> Response.new(200, "hello, #{who}\n")
    (Get, ["boom"])       -> panic("boom")
    _                     -> Response.new(404, "not found\n")
  }
}

fn parse_count(s: String) -> Option[Int] {
  Some(Int.parse(s)) escape { ParseError(_) -> None }
}
