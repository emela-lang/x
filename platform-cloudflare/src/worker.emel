# The handlers and the layer for running an Emela app as a Cloudflare Worker.
#
# The app is an HTTP service of `Std.Http.serve` (`[lib.http-service]`): Workers calls the `fetch`
# of the default export of `main.mjs` once per request, so `wrangler.toml` points `main` at it.
# The app opens WorkerPlatform inside the fn:
#
# ```emela
# import Cloudflare.Worker.{WorkerPlatform}
# import Std.Http
# import Std.Http.Request.{Request}
# import Std.Http.Response.{Response}
#
# @entry(Http.serve)
# pub fn app(request: Request) -> Response {
#   with WorkerPlatform { route(request) }
# }
# ```

import Std.Clock.{SystemClock}
import Std.Console.{SystemConsole}
import Std.Env.{Env}
import Std.Http.{SystemHttp}
import Std.Random.{SystemRandom}
import Kv.{WorkerKv}

@external(js, "./worker.mjs", "hasVar")
fn var_has(name: String) -> Bool

@external(js, "./worker.mjs", "getVar")
fn var_get(name: String) -> String

## The Worker's text variables and secrets (`[vars]` and `wrangler secret`). Bindings that are not
## text (KV namespaces and so on) are `None`.
pub handler WorkerEnv: Env {
  fn get(name) {
    if var_has(name) { Some(var_get(name)) } else { None }
  }
}

## The handlers that work on Workers, with WorkerKv on the KV namespace bound as `KV`.
## `Std.Platform` also has SystemFileSystem and reads `process.env`, which Workers does not have.
pub layer WorkerPlatform {
  SystemConsole
  SystemClock
  SystemRandom
  WorkerEnv
  SystemHttp
  WorkerKv(binding: "KV")
}
