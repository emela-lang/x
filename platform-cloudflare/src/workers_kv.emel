# Workers KV as a handler of Kv (x/kv).
#
# CloudflareKv uses the KV namespace bound under the name it is given
# (`with CloudflareKv(binding: "KV")`). CloudflarePlatform has it with `KV`; to use another one,
# list it after the layer: `with CloudflarePlatform, CloudflareKv(binding: "SESSIONS") { ... }`.

import Kv.{Kv}

## The outcome of a get on the host: whether the key was found, and its value.
@external
type HostValue

@external(js, "./workers_kv.mjs", "get")
suspend fn kv_get(binding: String, key: String) -> HostValue

@external(js, "./workers_kv.mjs", "found")
fn kv_found(v: HostValue) -> Bool

@external(js, "./workers_kv.mjs", "value")
fn kv_value(v: HostValue) -> String

@external(js, "./workers_kv.mjs", "put")
suspend fn kv_put(binding: String, key: String, value: String) -> ()

@external(js, "./workers_kv.mjs", "remove")
suspend fn kv_delete(binding: String, key: String) -> ()

## The KV namespace bound as `binding` in wrangler.toml. An error from Workers is a defect, and so
## is a `binding` that names no KV namespace.
##
## Workers KV is eventually consistent: a put can take 60 seconds or more to be seen by gets in
## other locations.
pub handler CloudflareKv(binding: String): Kv {
  init(binding: String) {
    CloudflareKv(binding:)
  }
  suspend fn get(key, resume) {
    v = kv_get(self.binding, key)
    resume(if kv_found(v) { Some(kv_value(v)) } else { None })
  }
  suspend fn put(key, value, resume) {
    kv_put(self.binding, key, value)
    resume(())
  }
  suspend fn delete(key, resume) {
    kv_delete(self.binding, key)
    resume(())
  }
}
