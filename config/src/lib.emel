# A typed configuration record read from environment variables.
#
# ```emela
# import Config
#
# config: AppConfig = Config.load("APP_")
# ```
#
# `Env` can only get a variable by its name, so the names come from the shape of the record: each
# field is the variable of its name in upper case, after the prefix (`port` is `APP_PORT`). The
# text of each variable is turned into the kind of value its field holds, and `from_dynamic_all`
# reads the record. Every variable that is missing or does not read is in the one ConfigError.
#
# The messages name the variable and what was expected, never the value, so that a secret held
# in a field of type `Redacted[String]` (x/redacted) does not reach a log through an error.

import Std.Env.{Env}
import Std.Map.{Map}
import Dynamic.{
  Dynamic,
  Decode,
  DecodeError,
  DecodeErrors,
  Key,
  Index,
  Null,
  Number,
  Text,
  Items,
  Bool,
}
import Dynamic.Number
import Shape.{Shape, Shaped, Field, Record}

## A variable that is missing or does not read as its field.
pub type Problem(variable: String, message: String) derive Eq, Show

## Every problem found by `load`, in the order of the fields. Never empty.
pub error ConfigError(problems: List[Problem])

impl ConfigError: Show {
  fn show(self) {
    List.map(self.problems, fn(p) { "#{p.variable}: #{p.message}" }) |> String.join("; ")
  }
}

## The record `A` read from the variables of its fields, named with `prefix` (`""` for none).
## A field of an Option type may be unset, and a List field unset is empty; an empty value counts
## as unset. A List field is read from a comma-separated value. A field whose type is a record,
## an enum or a Map cannot be read from one variable: Decode finds text where it expects fields.
##
## Panics if `A` is not a record: that is a mistake in the program, not in the environment.
pub fn load[A: Decode + Shaped](prefix: String) -> A fails ConfigError use { Env } {
  proxy: Option[A] = None
  shape = Shaped.shape(proxy)
  fields = record_fields(shape)
  env = use Env
  values = List.filter_map(fields, fn(field) {
    env.get(variable(prefix, field.name)) match {
      Some(text) if text != "" -> Some((field.name, from_text(field.shape, text)))
      _                        -> unset(field.shape) |> Option.map(fn(d) { (field.name, d) })
    }
  })
  Decode.from_dynamic_all(Dynamic.object(values)) escape {
    DecodeErrors(errors:) -> fail ConfigError(
      problems: List.map(errors, fn(e) { problem(prefix, e) }),
    )
  }
}

## The variable that holds the field `name`: `name` in upper case after `prefix`.
pub fn variable(prefix: String, name: String) -> String {
  "#{prefix}#{String.to_ascii_uppercase(name)}"
}

## The variables of the record `shape`, in the order of its fields.
pub fn variables(shape: Shape, prefix: String) -> List[String] {
  List.map(record_fields(shape), fn(field) { variable(prefix, field.name) })
}

## A `.env.example` for the record `shape`: each variable with a comment saying its type and its
## description, if it has one. A variable of an Option field is commented out, since it may be
## left unset.
##
## ```
## # Int: the port to listen on
## APP_PORT=
## # String (optional)
## # APP_LOG_LEVEL=
## ```
pub fn example(shape: Shape, prefix: String) -> String {
  List.map(record_fields(shape), fn(field) {
    name = variable(prefix, field.name)
    (kind, line) = Shape.strip(field.shape) match {
      Shape.Option(inner) -> ("#{Shape.name_of(inner)} (optional)", "# #{name}=")
      inner               -> (Shape.name_of(inner), "#{name}=")
    }
    about = Shape.note(field.shape, "description") match {
      Some(Text(text)) -> "#{kind}: #{text}"
      _                -> kind
    }
    "# #{about}\n#{line}\n"
  })
    |> String.concat()
}

# The value of a field whose variable is unset: an empty List, or nothing, which Decode reads as
# Null.
fn unset(shape: Shape) -> Option[Dynamic] {
  Shape.strip(shape) match {
    Shape.List(_) -> Some(Items([]))
    _             -> None
  }
}

fn record_fields(shape: Shape) -> List[Field] {
  Shape.strip(shape) match {
    Record(name: _, fields:) -> fields
    _ -> panic("x/config reads a record, but `#{Shape.name_of(shape)}` is not one")
  }
}

## `text`, the value of a variable, as the kind of value `shape` holds: a number for Int, Int64
## and Float, a Bool for `true`, `false`, `1`, `0`, `yes`, `no`, `on` and `off` in any case, and
## Items for a List, from the comma-separated parts. Text that does not turn is left as text, so
## that `Decode` reports it at the field.
pub fn from_text(shape: Shape, text: String) -> Dynamic {
  Shape.strip(shape) match {
    Shape.Option(inner) -> from_text(inner, text)
    Shape.List(item) -> Items(
      String.split(text, ",") |> List.map(fn(part) { from_text(item, String.trim(part)) }),
    )
    Shape.Int   -> number(text)
    Shape.Int64 -> number(text)
    Shape.Float -> number(text)
    Shape.Bool -> {
      word = String.to_ascii_lowercase(String.trim(text))
      if List.any(["true", "1", "yes", "on"], fn(w) { w == word }) {
        Bool(True)
      } else if List.any(["false", "0", "no", "off"], fn(w) { w == word }) {
        Bool(False)
      } else {
        Text(text)
      }
    }
    _           -> Text(text)
  }
}

fn number(text: String) -> Dynamic {
  Number(Number.parse(String.trim(text))) escape {
    ParseError(..) -> Text(text)
  }
}

# A failure of Decode as a problem with its variable. Its value is left out.
fn problem(prefix: String, e: DecodeError) -> Problem {
  (field, rest) = e.path match {
    [Key(name), ..rest] -> (name, rest)
    _                   -> ("", e.path)
  }
  at = List.map(rest, fn(segment) {
    segment match {
      Key(k)   -> ".#{k}"
      Index(i) -> "[#{i}]"
    }
  })
    |> String.concat()
  message = (e.actual, rest) match {
    (Null, [])    -> "is not set"
    _ if at == "" -> "expected #{e.expected}, found #{Dynamic.kind(e.actual)}"
    _             -> "#{at}: expected #{e.expected}, found #{Dynamic.kind(e.actual)}"
  }
  Problem(variable: variable(prefix, field), message:)
}

## Env with the variables `vars` and no others, for tests:
## `with TestEnv(vars: [("APP_PORT", "8080")]) { Config.load("APP_") }`.
pub handler TestEnv(vars: Map[String, String]): Env {
  init(vars: List[(String, String)]) {
    TestEnv(vars: Map.from_list(vars))
  }
  fn get(name) {
    Map.get(self.vars, name)
  }
}
