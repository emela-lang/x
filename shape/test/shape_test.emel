import Std.Map.{Map}
import Dynamic.{Dynamic, Number, Text}
import Dynamic.Number
import Rule
import Lib.{
  Shape,
  Shaped,
  Field,
  Variant,
  NoFields,
  PositionalFields,
  NamedFields,
  BoolShape,
  IntShape,
  StringShape,
  DynamicShape,
  ListOf,
  OptionOf,
  MapOf,
  Record,
  Variants,
  Ref,
  Named,
  Annotated,
}

## At least 1. The constructor checks it, so the shape carries it as a note.
type Quantity(value: Int)

impl Quantity: Shaped {
  fn shape_in(proxy, visiting) { IntShape |> Lib.annotate("minimum", Number(Number.from_int(1))) }
}

type Order(id: String, quantity: Quantity, tags: List[String], note: Option[String])

impl Order: Shaped {
  fn shape_in(proxy, visiting) {
    Lib.visit("Order", visiting, fn(visiting) {
      id: Option[String] = None
      quantity: Option[Quantity] = None
      tags: Option[List[String]] = None
      note: Option[Option[String]] = None
      Record(
        name: "Order",
        fields: [
          Field(name: "id", shape: Shaped.shape_in(id, visiting)),
          Field(name: "quantity", shape: Shaped.shape_in(quantity, visiting)),
          Field(name: "tags", shape: Shaped.shape_in(tags, visiting)),
          Field(name: "note", shape: Shaped.shape_in(note, visiting)),
        ],
      )
    })
  }
}

enum Tree {
  Leaf
  Pair(Int, Int)
  Node(left: Tree, right: Tree)
}

impl Tree: Shaped {
  fn shape_in(proxy, visiting) {
    Lib.visit("Tree", visiting, fn(visiting) {
      tree: Option[Tree] = None
      int: Option[Int] = None
      Variants(
        name: "Tree",
        variants: [
          Variant(name: "Leaf", contents: NoFields),
          Variant(
            name: "Pair",
            contents: PositionalFields(
              [Shaped.shape_in(int, visiting), Shaped.shape_in(int, visiting)],
            ),
          ),
          Variant(
            name: "Node",
            contents: NamedFields(
              [
                Field(name: "left", shape: Shaped.shape_in(tree, visiting)),
                Field(name: "right", shape: Shaped.shape_in(tree, visiting)),
              ],
            ),
          ),
        ],
      )
    })
  }
}

type Team(name: String, lead: Member)

type Member(name: String, team: Option[Team])

impl Team: Shaped {
  fn shape_in(proxy, visiting) {
    Lib.visit("Team", visiting, fn(visiting) {
      name: Option[String] = None
      lead: Option[Member] = None
      Record(
        name: "Team",
        fields: [
          Field(name: "name", shape: Shaped.shape_in(name, visiting)),
          Field(name: "lead", shape: Shaped.shape_in(lead, visiting)),
        ],
      )
    })
  }
}

impl Member: Shaped {
  fn shape_in(proxy, visiting) {
    Lib.visit("Member", visiting, fn(visiting) {
      name: Option[String] = None
      team: Option[Option[Team]] = None
      Record(
        name: "Member",
        fields: [
          Field(name: "name", shape: Shaped.shape_in(name, visiting)),
          Field(name: "team", shape: Shaped.shape_in(team, visiting)),
        ],
      )
    })
  }
}

@test
fn types_that_refer_to_each_other_end_at_the_first_repeat() {
  t: Option[Team] = None
  assert Shaped.shape(t)
    == Record(
      name: "Team",
      fields: [
        Field(name: "name", shape: StringShape),
        Field(
          name: "lead",
          shape: Record(
            name: "Member",
            fields: [
              Field(name: "name", shape: StringShape),
              Field(name: "team", shape: OptionOf(Ref("Team"))),
            ],
          ),
        ),
      ],
    )
  m: Option[Member] = None
  assert Lib.field_names(Shaped.shape(m)) == ["name", "team"]
}

@test
fn the_shapes_of_the_built_in_types() {
  assert Lib.of_value(True) == BoolShape
  assert Lib.of_value(["a"]) == ListOf(StringShape)
  assert Lib.of_value(Some(1)) == OptionOf(IntShape)
  assert Lib.of_value(Map.from_list([("a", 1)])) == MapOf(key: StringShape, value: IntShape)
  assert Lib.of_value(Text("a")) == DynamicShape
}

@test
fn a_proxy_needs_no_value() {
  p: Option[List[Option[Int]]] = None
  assert Shaped.shape(p) == ListOf(OptionOf(IntShape))
}

@test
fn a_record_lists_its_fields_in_order() {
  p: Option[Order] = None
  assert Lib.field_names(Shaped.shape(p)) == ["id", "quantity", "tags", "note"]
}

@test
fn a_note_is_read_back() {
  p: Option[Quantity] = None
  shape = Shaped.shape(p)
  assert Lib.strip(shape) == IntShape
  assert Lib.note(shape, "minimum") == Some(Number(Number.from_int(1)))
  assert Lib.note(shape, "maximum") == None
  assert Lib.note(IntShape, "minimum") == None
}

@test
fn annotate_replaces_a_note_of_the_same_name() {
  shape = IntShape
    |> Lib.annotate("minimum", Number(Number.from_int(1)))
    |> Lib.annotate("maximum", Number(Number.from_int(9)))
    |> Lib.annotate("minimum", Number(Number.from_int(2)))
  assert shape
    == Annotated(
      shape: IntShape,
      notes: [("maximum", Number(Number.from_int(9))), ("minimum", Number(Number.from_int(2)))],
    )
}

@test
fn field_names_look_through_notes() {
  p: Option[Order] = None
  annotated = Shaped.shape(p) |> Lib.annotate("description", Text("an order"))
  assert Lib.field_names(annotated) == ["id", "quantity", "tags", "note"]
  assert Lib.field_names(IntShape) == []
}

@test
fn a_recursive_type_refers_to_itself_by_name() {
  p: Option[Tree] = None
  Shaped.shape(p) match {
    Variants(name:, variants:) -> {
      assert name == "Tree"
      assert List.map(variants, fn(v) { v.name }) == ["Leaf", "Pair", "Node"]
    }
    _ -> assert False
  }
}

effect Orders {
  fn save(order: Order) -> ()
}

fn handle(order: Order) -> Int use Orders {
  (use Orders).save(order)
  1
}

@test
fn the_parameter_of_a_function_with_effects() {
  assert Lib.field_names(Lib.of_parameter(handle)) == ["id", "quantity", "tags", "note"]
}

type Page[A](items: List[A], next: Option[String])

impl Page[A: Shaped]: Shaped {
  fn shape_in(proxy, visiting) {
    item: Option[A] = None
    name = Lib.generic_name("Page", [Shaped.shape_in(item, visiting)])
    Lib.visit(name, visiting, fn(visiting) {
      items: Option[List[A]] = None
      next: Option[Option[String]] = None
      Record(
        name:,
        fields: [
          Field(name: "items", shape: Shaped.shape_in(items, visiting)),
          Field(name: "next", shape: Shaped.shape_in(next, visiting)),
        ],
      )
    })
  }
}

@test
fn a_name_carries_the_type_arguments() {
  p: Option[Page[Order]] = None
  assert Lib.name_of(Shaped.shape(p)) == "Page[Order]"
  q: Option[Map[String, List[Int]]] = None
  assert Lib.name_of(Shaped.shape(q)) == "Map[String, List[Int]]"
  assert Lib.generic_name("Page", []) == "Page"
}

## An opaque type is known by its name; its constructor checks the contents.
type Code(value: String)

impl Code: Shaped {
  fn shape_in(proxy, visiting) {
    Named(
      name: "Code",
      shape: StringShape |> Rule.annotate([Rule.min_length(3)]) |> Lib.pattern("^[A-Z]+$"),
    )
  }
}

@test
fn notes_are_read_through_a_name() {
  p: Option[Code] = None
  shape = Shaped.shape(p) |> Lib.description("a code")
  assert Lib.name_of(shape) == "Code"
  assert Lib.strip(shape) == StringShape
  assert Lib.note(shape, "description") == Some(Text("a code"))
  assert Lib.note(shape, "min_length") == Some(Number(Number.from_int(3)))
  assert Lib.note(shape, "pattern") == Some(Text("^[A-Z]+$"))
}
