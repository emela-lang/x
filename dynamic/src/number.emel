pub opaque type Number(negative: Bool, digits: String, exponent: Int) derive Eq, Show

pub error OutOfRange(number: Number) derive Show

# Reads a number in the JSON grammar: an optional `-`, an integer part without leading zeros,
# an optional `.` and fraction, and an optional `e` or `E` with an optional sign and digits.
# Fails also when the normalized exponent is outside the range of Int.
pub fn parse(s: String) -> Number fails ParseError {
  chars = String.chars(s)
  (negative, after_sign) = chars match {
    ["-", ..rest] -> (True, rest)
    _             -> (False, chars)
  }
  (whole, after_whole) = span_digits(after_sign)
  whole match {
    []           -> fail ParseError(input: s)
    ["0", _, ..] -> fail ParseError(input: s)
    _            -> ()
  }
  (fraction, after_fraction) = after_whole match {
    [".", ..rest] -> span_digits(rest)
    _             -> ([], after_whole)
  }
  if after_whole != after_fraction && fraction == [] {
    fail ParseError(input: s)
  }
  exponent = after_fraction match {
    []                                  -> 0
    [e, ..rest] if e == "e" || e == "E" -> exponent_part(s, rest)
    _                                   -> fail ParseError(input: s)
  }
  shifted = Int.checked_add(exponent, -List.length(fraction)) match {
    Some(e) -> normalize(negative, List.append(whole, fraction), e)
    None    -> None
  }
  shifted match {
    Some(n) -> n
    None    -> fail ParseError(input: s)
  }
}

# Reads the sign and digits after `e`, which must run to the end of the input `s`.
fn exponent_part(s: String, chars: List[String]) -> Int fails ParseError {
  (sign, after_sign) = chars match {
    ["-", ..rest] -> ("-", rest)
    ["+", ..rest] -> ("", rest)
    _             -> ("", chars)
  }
  (digits, after) = span_digits(after_sign)
  if digits == [] || after != [] {
    fail ParseError(input: s)
  }
  Int.parse("#{sign}#{String.concat(digits)}")
}

pub fn from_int(n: Int) -> Number {
  read(Int.to_string(n))
}

pub fn from_int64(n: Int64) -> Number {
  read(Int64.to_string(n))
}

# `None` for NaN and the infinities, which no number can hold.
pub fn from_float(f: Float) -> Option[Number] {
  s = Float.to_string(f)
  if Float.is_nan(f) || s == "Infinity" || s == "-Infinity" {
    None
  } else {
    Some(read(s))
  }
}

pub fn to_int(n: Number) -> Int fails OutOfRange {
  if n.exponent < 0 || n.exponent > 10 {
    fail OutOfRange(n)
  }

  sign = if n.negative { "-" } else { "" }

  Int.parse("#{sign}#{n.digits}#{zeros(n.exponent)}") escape {
    ParseError(..) -> fail OutOfRange(n)
  }
}

pub fn to_int64(n: Number) -> Int64 fails OutOfRange {
  if n.exponent < 0 || n.exponent > 19 {
    fail OutOfRange(n)
  }

  s = "#{n.digits}#{zeros(n.exponent)}"
  limit = if n.negative { "9223372036854775808" } else { "9223372036854775807" }
  length = String.length(s)
  if length > 19 || length == 19 && s > limit {
    fail OutOfRange(n)
  }

  # Accumulates downwards so that the minimum value, which has no positive counterpart, fits.
  below = List.fold(String.code_points(s), 0, fn(acc: Int64, c) {
    acc * 10 - Int64.from_int(c - 48)
  })
  if n.negative { below } else { -below }
}

pub fn to_float(n: Number) -> Float {
  Float.parse(to_string(n)) escape {
    ParseError(..) -> panic("to_string wrote a number that Float.parse cannot read")
  }
}

# Integral values up to 21 digits are written in full (`1500`), values with a short enough
# fraction with a point (`0.25`), and the rest with an exponent (`1.5e300`).
pub fn to_string(n: Number) -> String {
  sign = if n.negative { "-" } else { "" }
  chars = String.chars(n.digits)
  length = List.length(chars)
  # The conditions compare the exponent instead of `length + exponent`, which leaves the range of
  # Int for an exponent near its maximum.
  body = if n.exponent >= 0 && n.exponent <= 21 - length {
    "#{n.digits}#{zeros(n.exponent)}"
  } else if n.exponent < 0 && n.exponent > -length {
    point = length + n.exponent
    "#{String.concat(List.take(chars, point))}.#{String.concat(List.drop(chars, point))}"
  } else if n.exponent < 0 && n.exponent > -6 - length {
    "0.#{zeros(-(length + n.exponent))}#{n.digits}"
  } else {
    fraction = if length == 1 { "" } else { ".#{String.concat(List.drop(chars, 1))}" }
    scale = Int64.from_int(n.exponent) + Int64.from_int(length - 1)
    "#{String.concat(List.take(chars, 1))}#{fraction}e#{Int64.to_string(scale)}"
  }
  "#{sign}#{body}"
}

fn zeros(count: Int) -> String {
  String.concat(List.map(List.range(0, count), fn(_) { "0" }))
}

# Reads what `Int.to_string`, `Int64.to_string` and `Float.to_string` write, which is always in
# the grammar of `parse`.
fn read(s: String) -> Number {
  parse(s) escape {
    ParseError(..) -> panic("#{s} is not in the grammar of parse")
  }
}

# Splits off the leading digits of `chars`.
fn span_digits(chars: List[String]) -> (List[String], List[String]) {
  chars match {
    [c, ..rest] if c >= "0" && c <= "9" -> {
      (digits, after) = span_digits(rest)
      ([c, ..digits], after)
    }
    _ -> ([], chars)
  }
}

# Drops leading zeros of `digits`, and moves trailing zeros into the exponent. `None` when the
# exponent leaves the range of Int.
fn normalize(negative: Bool, digits: List[String], exponent: Int) -> Option[Number] {
  significant = drop_zeros(digits)
  trailing = List.length(significant) - List.length(drop_zeros(List.reverse(significant)))
  kept = List.take(significant, List.length(significant) - trailing)
  kept match {
    [] -> Some(Number(negative: False, digits: "0", exponent: 0))
    _ -> Int.checked_add(exponent, trailing) |> Option.map(fn(e) {
      Number(negative:, digits: String.concat(kept), exponent: e)
    })
  }
}

fn drop_zeros(digits: List[String]) -> List[String] {
  digits match {
    ["0", ..rest] -> drop_zeros(rest)
    _             -> digits
  }
}
