import Std.Map
import Lib.{Fields, Text, Null}

@test
fn builds_fields() {
  assert Lib.object([("a", Text("x")), ("b", Null)])
    == Fields(Map.from_list([("a", Text("x")), ("b", Null)]))
}

@test
fn keeps_the_later_value_of_a_repeated_key() {
  assert Lib.object([("a", Text("x")), ("a", Text("y"))]) == Lib.object([("a", Text("y"))])
}

@test
fn reads_back_with_field() {
  assert Lib.field(Lib.object([("name", Text("a"))]), "name", Lib.string) == "a"
}
